<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  SyncroFlow — web.config (IIS)
  Espelha o .htaccess do Apache (que o IIS ignora).
  Protege arquivos sensíveis, desativa listagem de pastas e
  adiciona cabeçalhos de segurança.
  ============================================================
-->
<configuration>
  <system.webServer>

    <!-- Página inicial -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
        <add value="login.php" />
      </files>
    </defaultDocument>

    <!-- Sem listagem de diretórios (= Options -Indexes) -->
    <directoryBrowse enabled="false" />

    <!-- Cabeçalhos de segurança (= mod_headers) -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>

        <!-- Bloqueia extensões sensíveis em qualquer lugar do site
             (.db, .db.enc, .log, .log.enc, .lock, .key, .enc) -->
        <fileExtensions>
          <add fileExtension=".db"   allowed="false" />
          <add fileExtension=".enc"  allowed="false" />
          <add fileExtension=".log"  allowed="false" />
          <add fileExtension=".lock" allowed="false" />
          <add fileExtension=".key"  allowed="false" />
          <add fileExtension=".sqlite" allowed="false" />
          <add fileExtension=".sqlite3" allowed="false" />
          <add fileExtension=".bak"  allowed="false" />
          <add fileExtension=".htaccess" allowed="false" />
        </fileExtensions>

        <!-- Bloqueia nomes/segmentos específicos: arquivos de config,
             chaves, a pasta de dados, includes internos e os scripts
             de manutenção (que continuam funcionando via linha de comando). -->
        <hiddenSegments>
          <add segment="config.json" />
          <add segment="config.local.json" />
          <add segment=".syncroflow.key" />
          <add segment="data" />
          <add segment="lib" />
          <add segment="partials" />
          <add segment="seed_demo.php" />
          <add segment="init_db.php" />
          <add segment="diagnostico.php" />
          <add segment="restore_backup.php" />
        </hiddenSegments>

      </requestFiltering>
    </security>

    <!-- Cache de estáticos (curto p/ CSS-JS, longo p/ imagens) -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
      <!-- IIS antigo não conhece .webp: sem isto as imagens dariam 404 -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

  </system.webServer>

  <!-- Cache mais longo apenas para a pasta de imagens -->
  <location path="imagens">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Módulos JS (ES modules): SEM cache agressivo. O navegador revalida a
       cada carga (304 se não mudou), garantindo que toda atualização do
       sistema apareça imediatamente após o deploy — sem precisar Ctrl+Shift+R. -->
  <location path="js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
